+// CFArray owns copies of AUPreset records and their CFString names.
+static const void *pixlRetainPreset(CFAllocatorRef, const void *value)
+{
+  const auto *source = static_cast<const AUPreset *>(value);
+  auto *copy = new AUPreset(*source);
+  CFRetain(copy->presetName);
+  return copy;
+}
+static void pixlReleasePreset(CFAllocatorRef, const void *value)
+{
+  const auto *preset = static_cast<const AUPreset *>(value);
+  CFRelease(preset->presetName);
+  delete preset;
+}
+static const PixlFactoryPresets *pixlPresets(const std::shared_ptr<Clap::Plugin> &plugin)
+{
+  if (!plugin || !plugin->_plugin) return nullptr;
+  return static_cast<const PixlFactoryPresets *>(
+      plugin->_plugin->get_extension(plugin->_plugin, PIXL_FACTORY_PRESETS_ID));
+}
+OSStatus WrapAsAUV2::GetPresets(CFArrayRef *outData) const
+{
+  const auto *ext = pixlPresets(_plugin);
+  if (!ext) return kAudioUnitErr_InvalidProperty;
+  if (!outData) return noErr; // AUBase property-info probe
+  const CFArrayCallBacks callbacks = {0, pixlRetainPreset, pixlReleasePreset, nullptr, nullptr};
+  auto array = CFArrayCreateMutable(nullptr, 0, &callbacks);
+  if (!array) return kAudioUnitErr_FailedInitialization;
+  for (uint32_t i = 0; i < ext->count(_plugin->_plugin); ++i)
+  {
+    PixlFactoryPresetInfo info{};
+    if (!ext->get(_plugin->_plugin, i, &info)) { CFRelease(array); return kAudioUnitErr_InvalidPropertyValue; }
+    auto name = CFStringCreateWithCString(nullptr, info.name, kCFStringEncodingUTF8);
+    if (!name) { CFRelease(array); return kAudioUnitErr_InvalidPropertyValue; }
+    AUPreset preset{info.number, name};
+    CFArrayAppendValue(array, &preset);
+    CFRelease(name);
+  }
+  *outData = array;
+  return noErr;
+}
+OSStatus WrapAsAUV2::NewFactoryPresetSet(const AUPreset &requested)
+{
+  const auto *ext = pixlPresets(_plugin);
+  if (!ext) return kAudioUnitErr_InvalidProperty;
+  auto guarantee_mainthread = _plugin->AlwaysMainThread();
+  for (uint32_t i = 0; i < ext->count(_plugin->_plugin); ++i)
+  {
+    PixlFactoryPresetInfo info{};
+    if (!ext->get(_plugin->_plugin, i, &info) || info.number != requested.presetNumber) continue;
+    if (!ext->load(_plugin->_plugin, info.number)) return kAudioUnitErr_InvalidPropertyValue;
+    auto name = CFStringCreateWithCString(nullptr, info.name, kCFStringEncodingUTF8);
+    AUPreset preset{info.number, name};
+    SetAFactoryPresetAsCurrent(preset);
+    if (_current_program_name) CFRelease(_current_program_name);
+    _current_program_name = CFStringCreateCopy(nullptr, name);
+    CFRelease(name);
+    PropertyChanged(kAudioUnitProperty_ClassInfo, kAudioUnitScope_Global, 0);
+    return noErr;
+  }
+  return kAudioUnitErr_InvalidPropertyValue;
+}
+OSStatus WrapAsAUV2::NewCustomPresetSet(const AUPreset &preset)
+{
+  const auto result = AUBase::NewCustomPresetSet(preset);
+  if (result == noErr)
+  {
+    if (_current_program_name) CFRelease(_current_program_name);
+    _current_program_name = CFStringCreateCopy(nullptr, preset.presetName);
+  }
+  return result;
+}
